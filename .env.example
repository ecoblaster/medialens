MEDIALENS_APP_NAME=MediaLens
MEDIALENS_APP_VERSION=1.1.0
MEDIALENS_API_V1_PREFIX=/api/v1
MEDIALENS_DATABASE_URL=sqlite:////data/medialens.db
MEDIALENS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MEDIALENS_AUTO_SCAN_ENABLED=true
MEDIALENS_FILE_STABILITY_SECONDS=60
MEDIALENS_RECONCILE_MINUTES=15
MEDIALENS_HOST_PORT=8090
MEDIALENS_DATA_PATH=./data
MEDIALENS_MOVIES_PATH=./example-media/movies
MEDIALENS_TV_PATH=./example-media/tv
